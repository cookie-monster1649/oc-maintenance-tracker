# Paperless-ngx Configuration
PAPERLESS_BASE_URL=http://localhost:8000/
PAPERLESS_API_TOKEN=your_paperless_api_token_here

# Document viewing domain (optional — defaults to PAPERLESS_BASE_URL if not set)
NEXT_PUBLIC_DOCUMENT_DOMAIN=http://localhost:8000/

# God Mode Password (for admin features in development)
NEXT_PUBLIC_GOD_MODE_PASSWORD=your_password_here
